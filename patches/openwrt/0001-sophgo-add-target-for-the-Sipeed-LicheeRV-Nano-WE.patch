diff --git a/target/linux/sophgo/files/arch/riscv/boot/dts/sophgo/sg2002-licheerv-nano-we.dts b/target/linux/sophgo/files/arch/riscv/boot/dts/sophgo/sg2002-licheerv-nano-we.dts
new file mode 100644
index 0000000..18fad98
--- /dev/null
+++ b/target/linux/sophgo/files/arch/riscv/boot/dts/sophgo/sg2002-licheerv-nano-we.dts
@@ -0,0 +1,78 @@
+// SPDX-License-Identifier: (GPL-2.0 OR MIT)
+/*
+ * Sipeed LicheeRV Nano WE: Ethernet plus AIC8800D Wi-Fi on SDIO.
+ *
+ * SDIO1 and GPIOA26 pinmux are set by the vendor U-Boot in fip.bin, so no
+ * pinctrl is described for them here.
+ */
+
+#include "sg2002-licheerv-nano-b.dts"
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+
+/ {
+	model = "LicheeRV Nano WE";
+	compatible = "sipeed,licheerv-nano-we", "sipeed,licheerv-nano", "sophgo,sg2002";
+
+	aliases {
+		ethernet0 = &gmac0;
+		mmc0 = &sdhci0;
+		mmc1 = &sdhci1;
+	};
+
+	/* The top 2 MiB of DRAM belongs to the second core's firmware area. */
+	memory@80000000 {
+		reg = <0x80000000 0x0fe00000>;
+	};
+
+	wifi_pwrseq: wifi-pwrseq {
+		compatible = "mmc-pwrseq-simple";
+		reset-gpios = <&porta 26 GPIO_ACTIVE_LOW>;
+		post-power-on-delay-ms = <100>;
+	};
+
+	/* The vendor device tree uses this pin as the user key. Hold 5 s to factory reset. */
+	keys {
+		compatible = "gpio-keys";
+
+		key-reset {
+			label = "reset";
+			gpios = <&porta 30 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_RESTART>;
+			debounce-interval = <60>;
+		};
+	};
+
+	soc {
+		restart-controller@5025000 {
+			compatible = "sophgo,restart";
+			reg = <0x05025000 0x2000>;
+		};
+	};
+};
+
+/* The PHY driver reads per-chip calibration from efuse, which needs these clocks. */
+&internal_ephy {
+	clocks = <&clk CLK_EFUSE>, <&clk CLK_APB_EFUSE>;
+};
+
+&gmac0 {
+	status = "okay";
+};
+
+&mdio {
+	status = "okay";
+};
+
+&sdhci1 {
+	status = "okay";
+	bus-width = <4>;
+	/* Vendor value. The Wi-Fi chip's VDDIO is 3.3 V, so 50 MHz is the likely ceiling. */
+	max-frequency = <25000000>;
+	mmc-pwrseq = <&wifi_pwrseq>;
+	no-1-8-v;
+	no-mmc;
+	no-sd;
+	non-removable;
+	keep-power-in-suspend;
+};
diff --git a/target/linux/sophgo/files/drivers/net/phy/cvitek-ephy.c b/target/linux/sophgo/files/drivers/net/phy/cvitek-ephy.c
new file mode 100644
index 0000000..b59a1cf
--- /dev/null
+++ b/target/linux/sophgo/files/drivers/net/phy/cvitek-ephy.c
@@ -0,0 +1,221 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * Internal 10/100 PHY of the Sophgo CV181x/SG200x SoCs.
+ *
+ * The init sequence comes from the vendor driver, drivers/net/phy/cvitek.c in
+ * sipeed/LicheeRV-Nano-Build, using its ARCH_CV181X filter values.
+ */
+
+#include <linux/clk.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/phy.h>
+
+#define CV181X_EPHY_ID			0x00435649
+
+#define REG_EPHY_TOP_WRAP		0x03009800
+#define REG_EPHY_BASE			0x03009000
+#define REG_EFUSE_SHADOW		0x03050100
+
+#define EFUSE_FLAGS			0x20
+#define EFUSE_VALUES			0x24
+#define EFUSE_TXECHORC_FLAG		BIT(8)
+#define EFUSE_TXITUNE_FLAG		BIT(9)
+#define EFUSE_TXRXTERM_FLAG		BIT(11)
+
+struct ephy_write {
+	u16 reg;
+	u16 val;
+};
+
+static void ephy_write_table(void __iomem *base, const struct ephy_write *t, size_t n)
+{
+	size_t i;
+
+	for (i = 0; i < n; i++)
+		writel(t[i].val, base + t[i].reg);
+}
+
+/* Reads calibration values. Both stay zero, meaning use defaults, on any failure. */
+static void ephy_read_efuse(struct phy_device *phydev, u32 *flags, u32 *values)
+{
+	struct device *dev = &phydev->mdio.dev;
+	struct clk_bulk_data *clks;
+	void __iomem *shadow;
+	int nclks;
+
+	*flags = 0;
+	*values = 0;
+
+	nclks = clk_bulk_get_all(dev, &clks);
+	if (nclks <= 0) {
+		phydev_warn(phydev, "no efuse clocks, using default tuning\n");
+		return;
+	}
+
+	if (clk_bulk_prepare_enable(nclks, clks)) {
+		phydev_warn(phydev, "efuse clocks failed, using default tuning\n");
+		goto out_put;
+	}
+
+	shadow = ioremap(REG_EFUSE_SHADOW, 0x100);
+	if (shadow) {
+		*flags = readl(shadow + EFUSE_FLAGS);
+		*values = readl(shadow + EFUSE_VALUES);
+		iounmap(shadow);
+	}
+
+	clk_bulk_disable_unprepare(nclks, clks);
+out_put:
+	clk_bulk_put_all(nclks, clks);
+}
+
+/* Register tables, in vendor order. 0x7c selects the MII register page. */
+static const struct ephy_write ephy_100baset[] = {
+	/* Rise update, falling phase, double TX bias current */
+	{ 0x5c, 0x0c10 }, { 0x68, 0x0003 }, { 0x54, 0x0000 },
+	/* Page 16: MLT3 positive phase code +0 and +I */
+	{ 0x7c, 0x1000 },
+	{ 0x68, 0x1000 }, { 0x6c, 0x3020 }, { 0x70, 0x5040 }, { 0x74, 0x7060 },
+	{ 0x58, 0x1708 }, { 0x5c, 0x3827 }, { 0x60, 0x5748 }, { 0x64, 0x7867 },
+	/* Page 17: MLT3 negative phase code -0 and -I */
+	{ 0x7c, 0x1100 },
+	{ 0x40, 0x9080 }, { 0x44, 0xb0a0 }, { 0x48, 0xd0c0 }, { 0x4c, 0xf0e0 },
+	{ 0x50, 0x9788 }, { 0x54, 0xb8a7 }, { 0x58, 0xd7c8 }, { 0x5c, 0xf8e7 },
+	/* Page 5 */
+	{ 0x7c, 0x0500 },
+};
+
+static const struct ephy_write ephy_pulse_idle_10baset[] = {
+	/* Page 10: link pulse */
+	{ 0x7c, 0x0a00 },
+	{ 0x40, 0x3e00 }, { 0x44, 0x7864 }, { 0x48, 0x6470 }, { 0x4c, 0x5f62 },
+	{ 0x50, 0x5a5a }, { 0x54, 0x5458 }, { 0x58, 0xb23a }, { 0x5c, 0x94a0 },
+	{ 0x60, 0x9092 }, { 0x64, 0x8a8e }, { 0x68, 0x8688 }, { 0x6c, 0x8484 },
+	{ 0x70, 0x0082 },
+	/* Page 11: TP_IDLE */
+	{ 0x7c, 0x0b00 },
+	{ 0x40, 0x5252 }, { 0x44, 0x5252 }, { 0x48, 0x4b52 }, { 0x4c, 0x3d47 },
+	{ 0x50, 0xaa99 }, { 0x54, 0x989e }, { 0x58, 0x9395 }, { 0x5c, 0x9091 },
+	{ 0x60, 0x8e8f }, { 0x64, 0x8d8e }, { 0x68, 0x8c8c }, { 0x6c, 0x8b8b },
+	{ 0x70, 0x008a },
+	/* Pages 13 to 16: 10BaseT data */
+	{ 0x7c, 0x0d00 },
+	{ 0x40, 0x1e0a }, { 0x44, 0x3862 }, { 0x48, 0x1e62 }, { 0x4c, 0x2a08 },
+	{ 0x50, 0x244c }, { 0x54, 0x1a44 }, { 0x58, 0x061c },
+	{ 0x7c, 0x0e00 },
+	{ 0x40, 0x2d30 }, { 0x44, 0x3470 }, { 0x48, 0x0648 }, { 0x4c, 0x261c },
+	{ 0x50, 0x3160 }, { 0x54, 0x2d5e },
+	{ 0x7c, 0x0f00 },
+	{ 0x40, 0x2922 }, { 0x44, 0x366e }, { 0x48, 0x0752 }, { 0x4c, 0x2556 },
+	{ 0x50, 0x2348 }, { 0x54, 0x0c30 },
+	{ 0x7c, 0x1000 },
+	{ 0x40, 0x1e08 }, { 0x44, 0x3868 }, { 0x48, 0x1462 }, { 0x4c, 0x1a0e },
+	{ 0x50, 0x305e }, { 0x54, 0x2f62 },
+};
+
+static const struct ephy_write ephy_agc_filters[] = {
+	/* Page 19: AGC max/min swing */
+	{ 0x7c, 0x1300 }, { 0x58, 0x0012 }, { 0x5c, 0x6848 },
+	/* Page 18: CV181x LPF(8, 8, 8, 8), HPF(-8, 50, -36, -8) */
+	{ 0x7c, 0x1200 }, { 0x48, 0x0808 }, { 0x4c, 0x0808 },
+	{ 0x50, 0x32f8 }, { 0x54, 0xf8dc },
+	/* Page 0 */
+	{ 0x7c, 0x0000 },
+};
+
+static int cv181x_ephy_config_init(struct phy_device *phydev)
+{
+	void __iomem *wrap, *base;
+	u32 flags, values, val;
+	int ret = 0;
+
+	ephy_read_efuse(phydev, &flags, &values);
+
+	wrap = ioremap(REG_EPHY_TOP_WRAP, 0x8);
+	if (!wrap)
+		return -ENOMEM;
+
+	base = ioremap(REG_EPHY_BASE, 0x80);
+	if (!base) {
+		ret = -ENOMEM;
+		goto out_wrap;
+	}
+
+	/* Use the APB interface to reach the PHY's internal pages. */
+	writel(0x0001, wrap + 4);
+	writel(0x0000, base + 0x7c);
+
+	/* Double bias current */
+	if (flags & EFUSE_TXITUNE_FLAG) {
+		val = ((values >> 24) & 0xff) | (((values >> 16) & 0xff) << 8);
+		writel((readl(base + 0x64) & ~0xffff) | val, base + 0x64);
+	} else {
+		writel(0x5a5a, base + 0x64);
+	}
+
+	/* Echo current */
+	if (flags & EFUSE_TXECHORC_FLAG)
+		writel((readl(base + 0x54) & ~0xff00) | (((values >> 8) & 0xff) << 8),
+		       base + 0x54);
+	else
+		writel(0x0000, base + 0x54);
+
+	/* TX termination and echo RC delay */
+	if (flags & EFUSE_TXRXTERM_FLAG) {
+		val = (((flags >> 28) & 0xf) << 4) | (((flags >> 24) & 0xf) << 8);
+		writel((readl(base + 0x58) & ~0xff0) | val, base + 0x58);
+	} else {
+		writel(0x0bb0, base + 0x58);
+	}
+
+	ephy_write_table(base, ephy_100baset, ARRAY_SIZE(ephy_100baset));
+
+	/* Still on page 5: enable TX termination, change RX common-mode voltage. */
+	writel(readl(base + 0x40) | 0x0001, base + 0x40);
+	writel(readl(base + 0x4c) | 0x0820, base + 0x4c);
+
+	ephy_write_table(base, ephy_pulse_idle_10baset, ARRAY_SIZE(ephy_pulse_idle_10baset));
+
+	/* Page 1: route link, speed and duplex to the LED pads. */
+	writel(0x0100, base + 0x7c);
+	writel(readl(base + 0x68) & ~0x0f00, base + 0x68);
+
+	ephy_write_table(base, ephy_agc_filters, ARRAY_SIZE(ephy_agc_filters));
+
+	/* Start auto-negotiation. Bit 7 stays clear, keeping the internal MDIO path. */
+	writel(0x090e, wrap);
+
+	/* The PHY comes out of reset as half duplex. */
+	writel(readl(base) | 0x0100, base);
+
+	/* Hand MDIO back to the MAC. */
+	writel(0x0000, wrap + 4);
+
+	phydev_info(phydev, "tuning applied, efuse flags %#x\n", flags);
+
+	iounmap(base);
+out_wrap:
+	iounmap(wrap);
+	return ret;
+}
+
+static struct phy_driver cv181x_ephy_driver[] = {
+	{
+		PHY_ID_MATCH_EXACT(CV181X_EPHY_ID),
+		.name		= "Sophgo CV181x EPHY",
+		.config_init	= cv181x_ephy_config_init,
+		.suspend	= genphy_suspend,
+		.resume		= genphy_resume,
+	},
+};
+module_phy_driver(cv181x_ephy_driver);
+
+static const struct mdio_device_id __maybe_unused cv181x_ephy_tbl[] = {
+	{ PHY_ID_MATCH_EXACT(CV181X_EPHY_ID) },
+	{ }
+};
+MODULE_DEVICE_TABLE(mdio, cv181x_ephy_tbl);
+
+MODULE_DESCRIPTION("Sophgo CV181x internal Ethernet PHY driver");
+MODULE_LICENSE("GPL");
diff --git a/target/linux/sophgo/files/drivers/power/reset/sophgo-reboot.c b/target/linux/sophgo/files/drivers/power/reset/sophgo-reboot.c
new file mode 100644
index 0000000..4018bc7
--- /dev/null
+++ b/target/linux/sophgo/files/drivers/power/reset/sophgo-reboot.c
@@ -0,0 +1,81 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Warm reset for Sophgo CV18xx/SG200x, using the RTC power control block.
+ * The vendor OpenSBI has no system reset for this platform.
+ *
+ * Derived from the driver by GP Orcullo in the OpenWrt cv18x0 port.
+ */
+
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/module.h>
+#include <linux/notifier.h>
+#include <linux/of_address.h>
+#include <linux/platform_device.h>
+#include <linux/reboot.h>
+
+#define RTC_CTRL0_UNLOCKKEY		0x4
+#define RTC_CTRL0			0x8
+#define RTC_BASE_OFFSET			0x1000
+#define RTC_EN_WARM_RST_REQ		0xcc
+#define RSM_STATE			0xd4
+#define ST_ON				0x3
+
+static void __iomem *base;
+
+static int sophgo_restart_handler(struct notifier_block *this,
+				  unsigned long mode, void *cmd)
+{
+	void __iomem *rtc = base + RTC_BASE_OFFSET;
+	u32 val;
+
+	/* Select prdata from the 32K domain. */
+	writel(0x1, rtc + 0x3c);
+	writel(0xab18, base + RTC_CTRL0_UNLOCKKEY);
+	writel(0x1, rtc + RTC_EN_WARM_RST_REQ);
+
+	if (readl_poll_timeout_atomic(rtc + RTC_EN_WARM_RST_REQ, val, val == 0x1, 10, 100000) ||
+	    readl_poll_timeout_atomic(rtc + RSM_STATE, val, val == ST_ON, 10, 100000))
+		pr_err("sophgo-reboot: RTC not ready, trying reset anyway\n");
+
+	writel(0xffff0800 | BIT(4), base + RTC_CTRL0);
+
+	return NOTIFY_DONE;
+}
+
+static struct notifier_block sophgo_restart_nb = {
+	.notifier_call = sophgo_restart_handler,
+	.priority = 128,
+};
+
+static int sophgo_reboot_probe(struct platform_device *pdev)
+{
+	int err;
+
+	/* of_iomap rather than a claimed region: this overlaps the RTC node. */
+	base = of_iomap(pdev->dev.of_node, 0);
+	if (!base)
+		return -ENOMEM;
+
+	err = register_restart_handler(&sophgo_restart_nb);
+	if (err) {
+		dev_err(&pdev->dev, "cannot register restart handler: %d\n", err);
+		iounmap(base);
+	}
+
+	return err;
+}
+
+static const struct of_device_id sophgo_reboot_of_match[] = {
+	{ .compatible = "sophgo,restart" },
+	{ }
+};
+
+static struct platform_driver sophgo_reboot_driver = {
+	.probe = sophgo_reboot_probe,
+	.driver = {
+		.name = "sophgo-reboot",
+		.of_match_table = sophgo_reboot_of_match,
+	},
+};
+builtin_platform_driver(sophgo_reboot_driver);

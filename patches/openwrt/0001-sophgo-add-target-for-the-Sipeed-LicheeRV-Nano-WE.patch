@@ -0,0 +1 @@
+BOARDNAME:=Generic
diff --git a/target/linux/sophgo/image/Makefile b/target/linux/sophgo/image/Makefile
new file mode 100644
index 0000000..3accbe7
--- /dev/null
+++ b/target/linux/sophgo/image/Makefile
@@ -0,0 +1,60 @@
+# SPDX-License-Identifier: GPL-2.0-only
+include $(TOPDIR)/rules.mk
+include $(INCLUDE_DIR)/image.mk
+
+SOPHGO_BOOT_PARTSIZE := 64
+# The vendor U-Boot loads boot.sd into a 16 MiB buffer at 0x81800000.
+SOPHGO_FIT_MAX := 16777216
+# The kernel decompresses to 0x80200000 and must end below that buffer. Leaves 1 MiB for BSS.
+SOPHGO_KERNEL_MAX := 22020096
+
+# fip.bin holds FSBL, OpenSBI and U-Boot. It comes from a vendor release, see fip/README.
+define Build/sophgo-sdcard
+	[ $$(stat -c %s $(IMAGE_KERNEL)) -le $(SOPHGO_KERNEL_MAX) ]
+	$(STAGING_DIR_HOST)/bin/lzma e $(IMAGE_KERNEL) $@.kernel.lzma
+	sed -e 's|@KERNEL@|$@.kernel.lzma|' \
+	    -e 's|@DTB@|$(DTS_DIR)/$(DEVICE_DTS).dtb|' \
+	    -e 's|@FIT_NAME@|$(FIT_NAME)|g' \
+	    ./boot.its > $@.its
+	$(STAGING_DIR_HOST)/bin/mkimage -f $@.its $@.fit
+	[ $$(stat -c %s $@.fit) -le $(SOPHGO_FIT_MAX) ]
+
+	rm -f $@.boot
+	mkfs.fat $@.boot -C $$(($(SOPHGO_BOOT_PARTSIZE) * 1024))
+	mcopy -i $@.boot ./fip/$(FIP) ::fip.bin
+	mcopy -i $@.boot $@.fit ::boot.sd
+	# U-Boot always decodes a boot logo. Without this file it decodes stale DRAM,
+	# which crashes in a reset loop after a warm reboot.
+	mcopy -i $@.boot ./fip/logo.jpeg ::logo.jpeg
+
+	./gen_sophgo_sdcard_img.sh \
+		$@ \
+		$@.boot \
+		$(IMAGE_ROOTFS) \
+		$(SOPHGO_BOOT_PARTSIZE) \
+		$(CONFIG_TARGET_ROOTFS_PARTSIZE)
+endef
+
+define Device/Default
+  PROFILES := Default
+  KERNEL_NAME := Image
+  KERNEL := kernel-bin
+  IMAGES := sdcard.img.gz
+  # Metadata goes after gzip, where sysupgrade's fwtool check can read it.
+  IMAGE/sdcard.img.gz := sophgo-sdcard | gzip | append-metadata
+endef
+
+define Device/sipeed_licheerv-nano-we
+  $(call Device/Default)
+  DEVICE_VENDOR := Sipeed
+  DEVICE_MODEL := LicheeRV Nano WE
+  DEVICE_DTS := sophgo/sg2002-licheerv-nano-we
+  FIP := licheerv-nano-20251230.bin
+  # The vendor U-Boot boots this exact FIT configuration name.
+  FIT_NAME := sg2002_licheervnano_sd
+  DEVICE_PACKAGES := kmod-aic8800-sdio aic8800-sdio-firmware wpad-basic-mbedtls iw \
+	kmod-gpio-button-hotplug travelmate luci-app-travelmate
+endef
+TARGET_DEVICES += sipeed_licheerv-nano-we
+
+$(eval $(call BuildImage))
diff --git a/target/linux/sophgo/image/boot.its b/target/linux/sophgo/image/boot.its
new file mode 100644
index 0000000..f68ea5e
--- /dev/null
+++ b/target/linux/sophgo/image/boot.its
@@ -0,0 +1,42 @@
+/dts-v1/;
+
+/ {
+	description = "OpenWrt for Sophgo SG200x";
+
+	images {
+		kernel-1 {
+			description = "Linux kernel";
+			data = /incbin/("@KERNEL@");
+			type = "kernel";
+			arch = "riscv";
+			os = "linux";
+			compression = "lzma";
+			load = <0x0 0x80200000>;
+			entry = <0x0 0x80200000>;
+			hash-1 {
+				algo = "crc32";
+			};
+		};
+
+		fdt-@FIT_NAME@ {
+			description = "Device tree";
+			data = /incbin/("@DTB@");
+			type = "flat_dt";
+			arch = "riscv";
+			compression = "none";
+			hash-1 {
+				algo = "sha256";
+			};
+		};
+	};
+
+	configurations {
+		default = "config-@FIT_NAME@";
+
+		config-@FIT_NAME@ {
+			description = "OpenWrt";
+			kernel = "kernel-1";
+			fdt = "fdt-@FIT_NAME@";
+		};
+	};
+};
diff --git a/target/linux/sophgo/image/fip/README b/target/linux/sophgo/image/fip/README
new file mode 100644
index 0000000..07c8edc
--- /dev/null
+++ b/target/linux/sophgo/image/fip/README
@@ -0,0 +1,10 @@
+licheerv-nano-20251230.bin is fip.bin (FSBL, OpenSBI, U-Boot) copied unmodified from the
+boot partition of the Sipeed vendor image:
+
+  https://github.com/sipeed/LicheeRV-Nano-Build/releases/download/20251230/2025-12-30-20-00-6073d5.img.xz
+
+logo.jpeg comes from the same boot partition. U-Boot decodes it on every boot. It must be present
+and valid, or a warm reboot crashes U-Boot in a loop.
+
+Its U-Boot sets the Wi-Fi SDIO pinmux and GPIOA26 mode, then boots boot.sd from the first FAT partition
+using FIT configuration config-sg2002_licheervnano_sd. The device tree relies on that pinmux.

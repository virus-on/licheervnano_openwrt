--- /dev/null
+++ b/target/linux/sophgo/Makefile
@@ -0,0 +1,22 @@
+# SPDX-License-Identifier: GPL-2.0-only
+
+include $(TOPDIR)/rules.mk
+
+ARCH:=riscv64
+BOARD:=sophgo
+BOARDNAME:=Sophgo SG200x RISC-V SoC
+FEATURES:=ext4 squashfs rootfs-part legacy-sdcard
+KERNELNAME:=Image dtbs
+SUBTARGETS:=generic
+
+KERNEL_PATCHVER:=6.18
+
+include $(INCLUDE_DIR)/target.mk
+
+DEFAULT_PACKAGES += e2fsprogs mkf2fs f2fsck partx-utils
+
+define Target/Description
+	Build firmware images for Sophgo SG200x RISC-V boards
+endef
+
+$(eval $(call BuildTarget))
diff --git a/target/linux/sophgo/base-files/etc/board.d/02_network b/target/linux/sophgo/base-files/etc/board.d/02_network
new file mode 100644
index 0000000..0ed01e2
--- /dev/null
+++ b/target/linux/sophgo/base-files/etc/board.d/02_network
@@ -0,0 +1,12 @@
+. /lib/functions/uci-defaults.sh
+
+board_config_update
+
+ucidef_set_interface_wan "eth0"
+# LAN has no physical port, so 90-licheewrt-network creates it as an empty bridge.
+# Declaring the protocol here is what makes odhcpd's defaults enable DHCP on it.
+ucidef_set_interface "lan" protocol "static"
+
+board_config_flush
+
+exit 0
diff --git a/target/linux/sophgo/base-files/etc/hotplug.d/ieee80211/20-licheewrt-ap b/target/linux/sophgo/base-files/etc/hotplug.d/ieee80211/20-licheewrt-ap
new file mode 100644
index 0000000..9fc29b9
--- /dev/null
+++ b/target/linux/sophgo/base-files/etc/hotplug.d/ieee80211/20-licheewrt-ap
@@ -0,0 +1,49 @@
+#!/bin/sh
+# Runs after 10-wifi-detect has created radio0. The SDIO radio appears
+# asynchronously after firmware load, so this can't be a uci-defaults script.
+# The key file is removed afterwards, so this only applies once.
+
+[ "$ACTION" = "add" ] || exit 0
+
+KEYFILE=/etc/licheewrt-wifi-key
+[ -f "$KEYFILE" ] || exit 0
+
+# The key file comes back from the read-only root after sysupgrade, while the
+# kept settings already have the user's Wi-Fi. The marker lives in the wireless
+# config, so it survives upgrades and goes away on factory reset.
+[ "$(uci -q get wireless.radio0.licheewrt_configured)" = "1" ] && {
+	rm -f "$KEYFILE"
+	exit 0
+}
+
+uci -q get wireless.radio0 >/dev/null || {
+	logger -t licheewrt-ap "radio0 not found, AP not configured"
+	exit 0
+}
+
+KEY="$(cat "$KEYFILE")"
+
+# The SDIO card address in the detected path is random per boot, so bind by phy.
+uci -q batch <<EOF
+delete wireless.radio0.path
+set wireless.radio0.phy='phy0'
+set wireless.radio0.disabled='0'
+set wireless.radio0.licheewrt_configured='1'
+set wireless.radio0.band='2g'
+set wireless.radio0.channel='6'
+set wireless.radio0.htmode='HT20'
+set wireless.radio0.country='UA'
+set wireless.default_radio0=wifi-iface
+set wireless.default_radio0.device='radio0'
+set wireless.default_radio0.network='lan'
+set wireless.default_radio0.mode='ap'
+set wireless.default_radio0.ssid='LicheeWRT'
+set wireless.default_radio0.encryption='psk2'
+set wireless.default_radio0.key='$KEY'
+set wireless.default_radio0.disabled='0'
+commit wireless
+EOF
+
+rm -f "$KEYFILE"
+logger -t licheewrt-ap "AP configured on radio0"
+/sbin/wifi reload

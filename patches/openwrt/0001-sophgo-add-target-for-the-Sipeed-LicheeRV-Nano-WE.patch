diff --git a/target/linux/sophgo/image/gen_sophgo_sdcard_img.sh b/target/linux/sophgo/image/gen_sophgo_sdcard_img.sh
new file mode 100755
index 0000000..9877a79
--- /dev/null
+++ b/target/linux/sophgo/image/gen_sophgo_sdcard_img.sh
@@ -0,0 +1,34 @@
+#!/bin/sh
+# SPDX-License-Identifier: GPL-2.0-only
+
+set -ex
+[ $# -eq 5 ] || {
+    echo "SYNTAX: $0 <file> <bootfs image> <rootfs image> <bootfs size> <rootfs size>"
+    exit 1
+}
+
+OUTPUT="$1"
+BOOTFS="$2"
+ROOTFS="$3"
+BOOTFSSIZE="$4"
+ROOTFSSIZE="$5"
+
+ROOTFSPTOFFSET=$(($BOOTFSSIZE + 1 + 1))
+
+head=4
+sect=63
+
+set $(ptgen -o "$OUTPUT" -h $head -s $sect -l 1024 -t c -p ${BOOTFSSIZE}M@1M -t 83 -p ${ROOTFSSIZE}M@${ROOTFSPTOFFSET}M)
+
+BOOTOFFSET="$(($1 / 512))"
+ROOTFSOFFSET="$(($3 / 512))"
+
+dd bs=512 if="$BOOTFS" of="$OUTPUT" seek="$BOOTOFFSET" conv=notrunc
+dd bs=512 if="$ROOTFS" of="$OUTPUT" seek="$ROOTFSOFFSET" conv=notrunc
+
+# fstools puts the writable overlay right after the squashfs, aligned to 64 KiB.
+# Zero 1 MiB there, so an upgrade wipes the old overlay's superblock and the new
+# firmware formats a fresh one instead of mounting stale data.
+ROOTFSBYTES=$(stat -c %s "$ROOTFS")
+OVERLAYSTART=$(( (ROOTFSBYTES + 65535) / 65536 * 65536 ))
+dd bs=64k if=/dev/zero of="$OUTPUT" seek=$(( ROOTFSOFFSET * 512 / 65536 + OVERLAYSTART / 65536 )) count=16 conv=notrunc
diff --git a/target/linux/sophgo/patches-6.18/100-riscv-dts-sophgo-add-licheerv-nano-we.patch b/target/linux/sophgo/patches-6.18/100-riscv-dts-sophgo-add-licheerv-nano-we.patch
new file mode 100644
index 0000000..d35567f
--- /dev/null
+++ b/target/linux/sophgo/patches-6.18/100-riscv-dts-sophgo-add-licheerv-nano-we.patch
@@ -0,0 +1,11 @@
+From: LicheeRV port <noreply@example.invalid>
+Subject: riscv: dts: sophgo: build LicheeRV Nano WE device tree
+
+--- a/arch/riscv/boot/dts/sophgo/Makefile
++++ b/arch/riscv/boot/dts/sophgo/Makefile
+@@ -1,4 +1,5 @@
+ # SPDX-License-Identifier: GPL-2.0
++dtb-$(CONFIG_ARCH_SOPHGO) += sg2002-licheerv-nano-we.dtb
+ dtb-$(CONFIG_ARCH_SOPHGO) += cv1800b-milkv-duo.dtb
+ dtb-$(CONFIG_ARCH_SOPHGO) += cv1812h-huashan-pi.dtb
+ dtb-$(CONFIG_ARCH_SOPHGO) += sg2000-milkv-duo-s.dtb
diff --git a/target/linux/sophgo/patches-6.18/101-sophgo-add-phy-and-restart-drivers.patch b/target/linux/sophgo/patches-6.18/101-sophgo-add-phy-and-restart-drivers.patch
new file mode 100644
index 0000000..c560e42
--- /dev/null
+++ b/target/linux/sophgo/patches-6.18/101-sophgo-add-phy-and-restart-drivers.patch
@@ -0,0 +1,53 @@
+From: LicheeRV port <noreply@example.invalid>
+Subject: drivers: add Sophgo CV181x PHY and restart drivers
+
+diff -ruN a/drivers/net/phy/Kconfig b/drivers/net/phy/Kconfig
+--- a/drivers/net/phy/Kconfig	2026-11-09 18:34:00.690469668 +0200
++++ b/drivers/net/phy/Kconfig	2026-11-09 18:34:00.703435679 +0200
+@@ -290,6 +290,11 @@
+ config BCM_NET_PHYPTP
+ 	tristate
+ 
++config CVITEK_PHY
++	tristate "Sophgo CV181x internal PHY"
++	help
++	  Supports the internal 10/100 PHY of Sophgo CV181x and SG200x SoCs.
++
+ config CICADA_PHY
+ 	tristate "Cicada PHYs"
+ 	help
+diff -ruN a/drivers/net/phy/Makefile b/drivers/net/phy/Makefile
+--- a/drivers/net/phy/Makefile	2026-11-09 18:34:00.692450516 +0200
++++ b/drivers/net/phy/Makefile	2026-11-09 18:34:00.701821232 +0200
+@@ -61,6 +61,7 @@
+ obj-$(CONFIG_BCM_NET_PHYPTP)	+= bcm-phy-ptp.o
+ obj-$(CONFIG_BROADCOM_PHY)	+= broadcom.o
+ obj-$(CONFIG_CICADA_PHY)	+= cicada.o
++obj-$(CONFIG_CVITEK_PHY)	+= cvitek-ephy.o
+ obj-$(CONFIG_CORTINA_PHY)	+= cortina.o
+ obj-$(CONFIG_DAVICOM_PHY)	+= davicom.o
+ obj-$(CONFIG_DP83640_PHY)	+= dp83640.o
+diff -ruN a/drivers/power/reset/Kconfig b/drivers/power/reset/Kconfig
+--- a/drivers/power/reset/Kconfig	2026-11-09 18:34:00.694447533 +0200
++++ b/drivers/power/reset/Kconfig	2026-11-09 18:34:00.707319758 +0200
+@@ -283,6 +283,12 @@
+ 	help
+ 	  Reboot support for the KEYSTONE SoCs.
+ 
++config POWER_RESET_SOPHGO
++	bool "Sophgo CV18xx restart driver"
++	depends on ARCH_SOPHGO || COMPILE_TEST
++	help
++	  Warm reset for Sophgo CV18xx and SG200x SoCs.
++
+ config POWER_RESET_SYSCON
+ 	bool "Generic SYSCON regmap reset driver"
+ 	depends on OF
+diff -ruN a/drivers/power/reset/Makefile b/drivers/power/reset/Makefile
+--- a/drivers/power/reset/Makefile	2026-11-09 18:34:00.696380004 +0200
++++ b/drivers/power/reset/Makefile	2026-11-09 18:34:00.705345642 +0200
+@@ -40,3 +40,4 @@
+ obj-$(CONFIG_POWER_RESET_SC27XX) += sc27xx-poweroff.o
+ obj-$(CONFIG_NVMEM_REBOOT_MODE) += nvmem-reboot-mode.o
+ obj-$(CONFIG_POWER_MLXBF) += pwr-mlxbf.o
++obj-$(CONFIG_POWER_RESET_SOPHGO) += sophgo-reboot.o
